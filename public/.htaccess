# ==============================================================================
# All Fresh Naturals - Hostinger Apache / LiteSpeed Production Configuration
# 1. PHP REST API Routing (/api/* -> api/index.php)
# 2. React Single Page Application (SPA) Client Routing
# 3. SSL / HTTPS Enforcement & Security Headers
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Route all API requests to the PHP REST API Router
  RewriteCond %{REQUEST_URI} ^/api(/.*)?$ [NC]
  RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

  # 3. Serve physical files directly (CSS, JS, JPG, PNG, SVG, WebP, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. React Single Page Application Client Routing (send non-file routes to index.html)
  RewriteRule ^ index.html [L]
</IfModule>

# Security & CORS Headers
<IfModule mod_headers.c>
  Header set Access-Control-Allow-Origin "https://allfreshnaturals.com"
  Header set Access-Control-Allow-Credentials "true"
  Header set Access-Control-Allow-Headers "Origin, X-Requested-With, Content-Type, Accept, Authorization, Cookie"
  Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

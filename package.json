{
  "name": "fresh_naturals",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n php,frontend -c green,cyan \"php -d extension=pdo_sqlite -S 127.0.0.1:8000 api/index.php\" \"vite\"",
    "start": "concurrently -n php,frontend -c green,cyan \"php -d extension=pdo_sqlite -S 127.0.0.1:8000 api/index.php\" \"vite\"",
    "frontend": "vite",
    "php": "php -d extension=pdo_sqlite -S 127.0.0.1:8000 api/index.php",
    "build": "node node_modules/vite/bin/vite.js build",
    "build:typecheck": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  }
}
